# Create a strong random secret; keep this value private.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=adoveautoimage

# Authenticated email address allowed unlimited designs and /admin access
ADMIN_EMAIL=your-login-email@example.com
# Required for security: exact Better Auth user ID of your own account
